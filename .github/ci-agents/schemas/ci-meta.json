{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["verdict", "rationale"],
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "rationale": { "type": "string" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "maxLength": 60 },
          "body": { "type": "string" }
        }
      }
    }
  }
}
